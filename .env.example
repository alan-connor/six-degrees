# Copy to .env (gitignored) or export these in your shell.
# backend/db.py falls back to these values when a variable is unset.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=six
PGDATABASE=sixdegrees

# Contact sent in the MusicBrainz User-Agent (an email or URL). Required by
# MusicBrainz etiquette -- set it to your own when running a crawl.
MB_CONTACT=you@example.com
